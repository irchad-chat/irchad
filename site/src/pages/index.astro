---
import logo from "../../../packaging/linux/party.gentoo.IrChad.svg?raw";
// Phosphor Icons (regular), inlined at build time.
const icons = import.meta.glob("/node_modules/@phosphor-icons/core/assets/regular/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const icon = (name: string) => icons[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`];
// Same release roots and asset names as chadd's landing page (crates/chadd/src/routes.rs, D44).
const repo = "https://git.gentoo.party/sam/irchad-ng";
const releases = "https://downloads.gentoo.party/irchad";
const builds = [
  { os: "Linux", icon: "linux-logo", asset: "irchad-linux-x86_64.tar.gz", cmd: "curl -fsSL https://irchad.chat/install.sh | sh", note: "x86_64. Paste that into a terminal. It installs for your user, without root, and the app updates itself. Or download the tarball and run irchad/install.sh.", nightly: true },
  { os: "Windows", icon: "windows-logo", asset: "irchad-windows-x86_64-setup.exe", note: "x86_64 installer. It installs for your user, with no admin prompt, and the app updates itself.", nightly: true },
  { os: "Android", icon: "android-logo", asset: "irchad-android-arm64.apk", note: "arm64 APK, sideloaded. No nightly builds.", nightly: false },
];
// Obtainium can't detect a self-hosted Gitea, so preset its Forgejo source ("Codeberg" class) or it scrapes HTML and makes up versions.
const obtainium = "obtainium://app/" + encodeURIComponent(JSON.stringify({
  id: "party.gentoo.irchad", url: repo, author: "sam", name: "IrChad",
  overrideSource: "Codeberg", additionalSettings: JSON.stringify({ includePrereleases: false }),
}));
const features = [
  ["Paste a link, start chatting", "An invite URL carries the whole network config. Log in and you're in your channels, with no server lists or nickserv."],
  ["Voice in every channel", "Click a channel's speaker and you're talking. It runs on PipeWire natively and has push-to-talk that works on Wayland."],
  ["Screen share with audio", "Share a screen or a window, sound included, on Wayland, on X11 and on Windows. Hardware encoding is used when your GPU has it."],
  ["Encrypted DMs", "DMs use the Olm double ratchet. You verify each other's devices by comparing emoji, and the server never sees the plaintext."],
  ["It's still IRC", "Text goes over IRCv3 to ergo, and everyone on plain IRC clients still sees a normal channel. IrChad's extras fall back to readable text for them."],
  ["You host it", "One compose file runs ergo, LiveKit and chadd behind Caddy, on your own server with no third party involved."],
];
const site = "https://irchad.chat/";
const title = "IrChad: a free, open-source, self-hosted Discord alternative";
const description = "IrChad is a free, open-source Discord alternative you host yourself. Text chat, voice channels, screen share and encrypted DMs, built on IRC. For Linux, Windows and Android.";
const jsonld = {
  "@context": "https://schema.org", "@type": "SoftwareApplication", name: "IrChad", url: site,
  description, applicationCategory: "CommunicationApplication", operatingSystem: "Linux, Windows, Android",
  license: "https://www.gnu.org/licenses/gpl-3.0.html", image: `${site}screenshot.webp`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
// Answers to what people search for when leaving Discord. Keep these true to the current feature table.
const faq = [
  ["Is IrChad a Discord alternative?", "Yes. It has the parts people use Discord for: servers with channels, voice channels, screen share with audio, replies, reactions, GIFs, uploads and DMs. The difference is that the network runs on servers you control."],
  ["Is it free and open source?", "Yes. IrChad, its server chadd and the whole deploy stack are free software under the GPL-3.0. There are no paid tiers, no ads and no tracking."],
  ["Can I self-host it?", "Yes, that's the point. One compose file runs ergo (IRC), LiveKit (voice and video), chadd and Caddy on your own box. Your messages and uploads stay there."],
  ["Does it work on Linux?", "Linux is the main platform, with Wayland and X11 both supported. Voice is PipeWire-native, push-to-talk works on Wayland, and screen share goes through the desktop portal."],
  ["Do my friends need to know IRC?", "No. They open your invite link, pick a name and start chatting, with no server lists or NickServ. People who do like IRC can still join from any IRC client."],
];
// [feature, details, Linux, Windows]. Keep in step with docs/phases/; claim only what's ticked there.
const table = [
  ["Invite links", "Paste an https:// or irchad:// link. Join as a guest, log in, or sign up without leaving the app.", "✓", "✓"],
  ["Several networks", "Be on more than one network at once, each in the server rail.", "✓", "✓"],
  ["Always online", "Your account stays in its channels after you close the app, the way it does on Discord. Your PC and phone are the same user, not separate nicks, and the network keeps what's said while you're away. No bouncer needed. (Guests are the exception: they leave when they close the app.)", "✓", "✓"],
  ["History", "Scrollback comes from the server (IRCv3 chathistory) and is cached locally, so it shows up instantly. Read markers sync across your devices.", "✓", "✓"],
  ["Replies, reactions, typing", "Reply to a message, react with emoji, see who's typing, and delete your own messages.", "✓", "✓"],
  ["Read receipts", "Optional \"Seen\" under your DMs, off by default. They only show when both of you turn them on, and the setting follows your account to every device.", "✓", "✓"],
  ["Emoji and GIFs", "An emoji picker, :shortcodes:, and GIF search from the composer or with /gif.", "✓", "✓"],
  ["Uploads and previews", "Share files and images, with inline media and link previews. Previews are fetched by the server, so your IP isn't leaked. You can also set media to click-to-load.", "✓", "✓"],
  ["Profiles and presence", "Display names, avatars, and away status that follows your idle time.", "✓", "✓"],
  ["Voice channels", "Echo cancellation, noise suppression (with optional RNNoise), and voice activity or push-to-talk. Audio is PipeWire-native on Linux.", "✓", "✓"],
  ["Soundboard", "The network's own clips, played into the call with a separate volume.", "✓", "✓"],
  ["Screen share", "A screen or a window at 720p30, 1080p60 or source resolution, with hardware encoding where available.", "✓", "✓"],
  ["App audio in shares", "Share one app's sound without your notifications or music coming along.", "✓", "✓"],
  ["Watching shares", "Stage view, fullscreen, pop-out, a floating window, or a tile next to your chat.", "✓", "✓"],
  ["Encrypted DMs", "End-to-end encrypted with Olm. Verify devices by comparing emoji, and get a warning when a contact's keys change.", "✓", "✓"],
  ["Desktop integration", "Notifications, tray icon, Ctrl+K quick switcher, input methods for CJK, and screen-reader support.", "✓", "✓"],
  ["Plays nice with IRC", "People on plain IRC clients see normal messages. IrChad's extras fall back to readable text.", "✓", "✓"],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="description" content={description} />
  <link rel="canonical" href={site} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="IrChad" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={site} />
  <meta property="og:image" content={`${site}screenshot.webp`} />
  <meta property="og:image:alt" content="IrChad's main window with channels, chat and members." />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
</head>
<body>
  <main>
    <header>
      <div class="hero">
        <div class="logo" aria-hidden="true" set:html={logo} />
        <h1>IrChad</h1>
        <p class="lede">A free, open-source Discord alternative you host yourself. Voice, screen share and encrypted DMs, built on IRC.</p>
        <p class="cta">
          <a class="btn primary" href="/invite"><Fragment set:html={icon("sign-in")} />Get the app &amp; join the official server</a>
          <a class="btn secondary" href="/chat/"><Fragment set:html={icon("globe")} />Join in your browser</a>
          <a class="btn secondary" href="#download"><Fragment set:html={icon("download-simple")} />Download</a>
          <a class="btn secondary" href="#host"><Fragment set:html={icon("hard-drives")} />Host a network</a>
          <a class="btn secondary" href="/docs"><Fragment set:html={icon("book-open")} />Docs</a>
          <a class="btn secondary" href={repo}><Fragment set:html={icon("code")} />Source code</a>
        </p>
      </div>
      <a href="/screenshot.webp"><img class="shot" src="/screenshot.webp" width="1400" height="1394" alt="IrChad's main window: the channel list, a conversation in #chad with an inline GIF, and the member list." /></a>
    </header>

    <section aria-labelledby="features">
      <h2 id="features">What you get</h2>
      <ul class="grid">
        {features.map(([title, body]) => <li class="card"><h3>{title}</h3><p>{body}</p></li>)}
      </ul>
    </section>

    <section aria-labelledby="all-features">
      <h2 id="all-features">Features</h2>
      <div class="scroll">
        <table>
          <thead><tr><th scope="col">Feature</th><th scope="col">Details</th><th scope="col">Linux</th><th scope="col">Windows</th></tr></thead>
          <tbody>
            {table.map(([name, details, linux, windows]) => (
              <tr><th scope="row">{name}</th><td>{details}</td><td class="mark">{linux}</td><td class="mark">{windows}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted small">On Android, voice and watching screen shares work. The rest of the Android app is still in progress.</p>
    </section>

    <section aria-labelledby="discord-alternative">
      <h2 id="discord-alternative">A Discord alternative you own</h2>
      {faq.map(([q, a]) => <><h3>{q}</h3><p class="muted">{a}</p></>)}
    </section>

    <section aria-labelledby="download">
      <h2 id="download">Download</h2>
      <p class="muted">Linux (Wayland and X11) comes first, and Windows is supported. These links point to the latest release.</p>
      <ul class="grid">
        {builds.map((b) => (
          <li class="card">
            <h3>{b.os}</h3>
            {b.cmd && <pre><code>{b.cmd}</code></pre>}
            <p>{b.note} {b.nightly && <a href={`${releases}/nightly/${b.asset}`} download>Nightly build</a>}</p>
            <a class="btn primary" href={`${releases}/latest/${b.asset}`} download><Fragment set:html={icon(b.icon)} />Download for {b.os}</a>
            {b.os === "Android" && <a class="btn secondary" href={obtainium}><Fragment set:html={icon("package")} />Add to Obtainium</a>}
            {b.os === "Android" && <a class="btn secondary" href="/beta"><Fragment set:html={icon("google-play-logo")} />Join the Play Store beta</a>}
          </li>
        ))}
      </ul>
      <p class="muted small">On Gentoo, use <a href="/docs/getting-started#gentoo">the overlay</a>. Nightly builds are rebuilt each night from <code>main</code>, so expect some breakage. <a href={`${repo}/releases`}>All releases</a></p>
    </section>

    <section aria-labelledby="host">
      <h2 id="host">Host a network</h2>
      <p>An IrChad network has four parts:</p>
      <ul class="plain">
        <li><b>ergo</b> (2.19 or newer), the IRC server. IrChad only supports ergo.</li>
        <li><b>LiveKit</b>, which carries voice and screen share.</li>
        <li><b>chadd</b>, a small server for discovery, login, voice tokens and uploads.</li>
        <li><b>Caddy</b>, which serves all of them over one HTTPS origin.</li>
      </ul>
      <p>The <a href={`${repo}/src/branch/main/deploy`}><code>deploy/</code></a> directory has a compose file for all four. It's a dev stack, so replace every secret in it before you expose it.</p>
      <p>Admins manage the network with any normal IRC client. IrChad doesn't have an admin UI yet.</p>
    </section>
  </main>
  <footer>
    <a href="/docs">Docs</a> · <a href={repo}>Source</a> ·<a href={`${repo}/src/branch/main/docs/PLAN.md`}>Roadmap</a> · <a href="/privacy">Privacy</a> · <a href="/delete-account">Delete account</a>
    <a class="badge" href="https://alternativeto.net/software/irchad/about/?utm_source=badge&utm_medium=referral">
      <picture>
        <source srcset="https://alternativeto.net/static/badges/badge-compact-dark.svg" media="(prefers-color-scheme: dark)" />
        <img src="https://alternativeto.net/static/badges/badge-compact-light.svg" alt="IrChad on AlternativeTo" width="244" height="83" loading="lazy" />
      </picture>
    </a>
  </footer>
</body>
</html>

<style is:global>
  /* Catppuccin Latte/Mocha, the same defaults as chadd's invite page (crates/chadd/src/routes.rs LIGHT/DARK). */
  :root { color-scheme: light dark; --bg: #e6e9ef; --card: #eff1f5; --fg: #4c4f69; --muted: #6c6f85; --accent: #40a02b; --accent-2: #179299; --on-accent: #1e1e2e; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #11111b; --card: #1e1e2e; --fg: #cdd6f4; --muted: #a6adc8; --accent: #a6e3a1; --accent-2: #94e2d5; }
  }
  :root { --line: color-mix(in srgb, var(--fg) 12%, transparent); }
  * { box-sizing: border-box; }
  body { margin: 0; background: radial-gradient(60rem 30rem at 50% -10%, color-mix(in srgb, var(--accent) 22%, transparent), transparent), var(--bg);
    color: var(--fg); font: 16px/1.6 system-ui, sans-serif; }
  main, footer { max-width: 64rem; margin: 0 auto; padding: 0 16px; }
  a { color: inherit; text-decoration-color: var(--accent); }
  header { text-align: center; padding: 3rem 0; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 60rem) { header { grid-template-columns: 1fr 1.4fr; text-align: left; } header .cta { justify-content: flex-start; } header .logo { margin: 0; } }
  .shot { width: 100%; height: auto; border-radius: 1rem; border: 1px solid var(--line); box-shadow: 0 20px 60px #0000004d; }
  .logo { width: 5rem; height: 5rem; margin: 0 auto; } .logo svg { width: 100%; height: 100%; }
  h1 { font-size: clamp(2.5rem, 8vw, 4rem); margin: 1rem 0 0; letter-spacing: -.02em; }
  .lede { font-size: 1.2rem; color: var(--muted); margin: .5rem auto 0; max-width: 36rem; }
  .cta { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem; }
  section { padding: 2.5rem 0; border-top: 1px solid var(--line); }
  h2 { font-size: 1.75rem; margin: 0 0 1rem; }
  h3 { font-size: 1.05rem; margin: 0 0 .25rem; }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .card { padding: 1.25rem; border: 1px solid var(--line); border-radius: 1rem; background: color-mix(in srgb, var(--card) 80%, transparent); backdrop-filter: blur(12px);
    display: flex; flex-direction: column; gap: .5rem; }
  .card p { margin: 0; color: var(--muted); flex: 1; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .75rem 1.25rem; border-radius: 12px;
    font-weight: 600; text-decoration: none; text-align: center; transition: transform .1s, filter .15s; }
  .btn:hover { filter: brightness(1.1); } .btn:active { transform: scale(.98); }
  .btn svg { width: 1.25em; height: 1.25em; flex: none; }
  .btn:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .primary { color: var(--on-accent); background: linear-gradient(135deg, var(--accent), var(--accent-2)); }
  .secondary { color: var(--fg); border: 1px solid var(--line); }
  .muted { color: var(--muted); }
  .small { font-size: .85rem; }
  .plain { padding-left: 1.25rem; }
  code { font-size: .9em; }
  .card pre { margin: 0; padding: .6rem .8rem; border-radius: 8px; background: var(--bg); white-space: pre-wrap; overflow-wrap: break-word; user-select: all; font-size: .85rem; }
  .scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 1rem; background: color-mix(in srgb, var(--card) 80%, transparent); }
  table { width: 100%; border-collapse: collapse; min-width: 36rem; }
  th, td { padding: .75rem 1rem; text-align: left; vertical-align: top; border-top: 1px solid var(--line); }
  thead th { border-top: 0; font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  @media (min-width: 48rem) { tbody th { white-space: nowrap; } }
  td { color: var(--muted); }
  td.mark { text-align: center; white-space: nowrap; color: var(--fg); }
  .badge { display: block; width: fit-content; margin-top: 1rem; } .badge img { display: block; }
  footer { padding-top: 1.5rem; padding-bottom: 3rem; color: var(--muted); font-size: .875rem; border-top: 1px solid var(--line); }
</style>
