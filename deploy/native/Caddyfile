# Production routing per docs/ARCHITECTURE.md; same routes as deploy/Caddyfile,
# services on loopback. Caddy gets the certificate from Let's Encrypt.

{$IRCHAD_HOST} {
	handle /.well-known/irchad.json {
		header Access-Control-Allow-Origin *
		reverse_proxy 127.0.0.1:8080
	}
	handle /invite* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /api/* {
		# Uploads are capped by chadd's uploads.max_bytes.
		# chadd takes bearer tokens, never cookies, so any page may call it:
		# the web client in dev (Vite's origin) or served from elsewhere.
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Headers "Authorization, Content-Type, Content-Disposition, If-None-Match"
		header Access-Control-Expose-Headers ETag
		header Access-Control-Max-Age 86400
		@preflight method OPTIONS
		respond @preflight 204
		reverse_proxy 127.0.0.1:8080
	}
	handle /uploads/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /emoji/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /irc {
		reverse_proxy 127.0.0.1:8097
	}
	# The LiveKit SDK appends /rtc etc. to the URL, so strip our prefix.
	handle_path /livekit/* {
		reverse_proxy 127.0.0.1:7880
	}
	# Everything else is the project website (site/dist). Without it, 404.
	handle {
		root * /var/www/irchad
		file_server
	}
}
